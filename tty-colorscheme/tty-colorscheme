#!/bin/bash

set -euo pipefail

cs_dir="/etc/tty-colorscheme/colorschemes"

_fill_cs_arr() {
    mapfile -t cs_arr < <(
        find "${cs_dir}"/* 2> /dev/null | awk -F/ '{print $NF}'
    )
}

_fill_fnt_arr() {
    for dir in /usr/share/consolefonts /usr/share/kbd/consolefonts /usr/lib/kbd/consolefonts; do
        [[ -d "${dir}" ]] && dirs+=("${dir}")
    done
    if (( ${#dirs[@]} > 0 )); then
        mapfile -t fnt_arr < <(
            find "${dirs[@]}" -name "*.psf*.gz" \
                | awk -F/ '{print $NF}' \
                | sort -V
        )
    fi
}

_set_colors() {
    printf "\e]P0%s\e]P1%s\e]P2%s\e]P3%s\e]P4%s\e]P5%s\e]P6%s\e]P7%s" \
           "${color01:?}" "${color02:?}" "${color03:?}" "${color04:?}" \
           "${color05:?}" "${color06:?}" "${color07:?}" "${color08:?}"
    printf "\e]P8%s\e]P9%s\e]PA%s\e]PB%s\e]PC%s\e]PD%s\e]PE%s\e]PF%s" \
           "${color09:?}" "${color10:?}" "${color11:?}" "${color12:?}" \
           "${color13:?}" "${color14:?}" "${color15:?}" "${color16:?}"
}

_set_font() {
    fnt="${1}"
    if [[ "$(id -u)" -eq 0 ]]; then
        for i in {1..6}; do setfont "${fnt}" -C "/dev/tty${i}"; done
    else
        setfont "${fnt}"
    fi
    clear
    showconsolefont
    printf "Setting font: %s\n\n" "${fnt%%.*}"
}

list_schemes() {
    _fill_cs_arr
    if (( ${#cs_arr[@]} == 0 )); then
        printf "No colorschemes found\n" 1>&2
        exit 1
    fi
    printf "%s\n" "${cs_arr[@]}"
}

list_fonts() {
    _fill_fnt_arr
    if (( ${#fnt_arr[@]} == 0 )); then
        printf "No PSF fonts found\n" 1>&2
        exit 1
    fi
    printf "%s\n" "${fnt_arr[@]%%.*}"
}

print_palette() {
    cnt="1"
    for bkgrnd in {40..47}; do
        printf "\e[%sm" "${bkgrnd}"
        for bold in 22 1; do
            printf "\e[%sm" "${bold}"
            for frgrnd in {30..37}; do
                printf "\e[%sm %3s" "${frgrnd}" "${cnt}"
                cnt="$((cnt + 1))"
            done
        done
        printf "\e[0m\n"
    done
}

cycle_through() {
    _fill_cs_arr
    _fill_fnt_arr

    cs_max="$(( ${#cs_arr[@]} - 1 ))"
    fnt_max="$(( ${#fnt_arr[@]} - 1 ))"
    cs_idx="-1"
    fnt_idx="-1"
    mode=""

    clear
    while true; do
        case "${mode}" in
            "cs")
                if (( cs_idx >= 0 && cs_idx <= cs_max )); then
                    set_scheme "${cs_arr[cs_idx]}"
                    printf "[%d/%d]\n" "$((cs_idx + 1))" "$((cs_max + 1))"
                else
                    clear
                    printf "No colorschemes found\n" 1>&2
                fi
                ;;
            "fnt")
                if (( fnt_idx >= 0 && fnt_idx <= fnt_max )); then
                    _set_font "${fnt_arr[fnt_idx]}"
                    printf "[%d/%d]\n" "$((fnt_idx + 1))" "$((fnt_max + 1))"
                else
                    clear
                    printf "No PSF fonts found\n" 1>&2
                fi
                ;;
        esac

        printf "\nUse j/k keys to cycle through colorschemes\n"
        printf "Use h/l keys to cycle through fonts\n"

        read -rsn1
        case "${REPLY}" in
            "j")
                mode="cs"
                if (( cs_idx < cs_max )); then
                    cs_idx="$((cs_idx + 1))"
                else
                    cs_idx="0"
                fi
                ;;
            "k")
                mode="cs"
                if (( cs_idx > 0 )); then
                    cs_idx="$((cs_idx - 1))"
                elif (( cs_idx == -1 )); then
                    cs_idx="0"
                else
                    cs_idx="${cs_max}"
                fi
                ;;
            "l")
                mode="fnt"
                if (( fnt_idx < fnt_max )); then
                    fnt_idx="$((fnt_idx + 1))"
                else
                    fnt_idx="0"
                fi
                ;;
            "h")
                mode="fnt"
                if (( fnt_idx > 0 )); then
                    fnt_idx="$((fnt_idx - 1))"
                elif (( fnt_idx == -1 )); then
                    fnt_idx="0"
                else
                    fnt_idx="${fnt_max}"
                fi
                ;;
            *)
                exit 0
                ;;
        esac
    done
}

set_scheme() {
    cs="${1}"

    if [[ ! -f "${cs_dir}/${cs}" ]]; then
        printf "Invalid colorscheme: %s\n" "${cs}" 1>&2
        exit 1
    fi

    unset color{01..16}
    source "${cs_dir}/${cs}"

    for i in {01..16}; do
        color_var="color${i}"
        if [[ ! -v "${color_var}" ]]; then
            printf "Missing %s in scheme %s\n" "${color_var}" "${cs}" 1>&2
            exit 1
        fi
        if ! [[ "${!color_var}" =~ ^[0-9A-Fa-f]{6}$ ]]; then
            printf "Invalid value for %s in scheme %s: %s\n" "${color_var}" "${cs}" "${!color_var}" 1>&2
            exit 1
        fi
    done

    if [[ "$(id -u)" -eq 0 ]]; then
        for i in {1..6}; do _set_colors > "/dev/tty${i}"; done
    else
        _set_colors
    fi

    if [[ "${TERM}" == "linux" ]]; then
        clear
        print_palette
    fi

    printf "\nSetting colorscheme: %s\n\n" "${cs}"
}

print_help() {
    progname="${0##*/}"

    printf "Usage: %s <option | colorscheme>\n" "${progname}"
    printf "  -l    List available colorschemes\n"
    printf "  -f    List available PSF fonts\n"
    printf "  -p    Print the current palette\n"
    printf "  -c    Cycle through colorschemes and fonts\n"

    tty | grep -q tty || printf "%s should be run from TTY\n" "${progname}" 1>&2
}

if [[ "${#}" -gt 1 ]]; then
    printf "Only 1 option or 1 argument is accepted\n" 1>&2
    print_help
    exit 1
elif [[ "${#}" -eq 0 ]]; then
    print_help
    exit 0
fi

case "${1}" in
    "-l")
        list_schemes
        ;;
    "-f")
        list_fonts
        ;;
    "-p")
        print_palette
        ;;
    "-c")
        cycle_through
        ;;
    "-"*)
        printf "Invalid option: %s\n" "${1}" 1>&2
        print_help
        exit 1
        ;;
    *)
        set_scheme "${1}"
        ;;
esac
